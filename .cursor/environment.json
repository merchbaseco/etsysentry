{
  "name": "Merchbase EtsySentry",
  "install": "bash .agents/cloud/bootstrap.sh cursor-install",
  "start": "bash .agents/cloud/bootstrap.sh cursor",
  "ports": [
    { "name": "api", "port": 8080 },
    { "name": "website", "port": 3100 }
  ],
  "terminals": [
    {
      "name": "dev",
      "command": ". .agents/cloud/env.sh && ETSYSENTRY_DEV_HOST=0.0.0.0 bun run dev"
    }
  ]
}
