# The plugin version is pinned so the schema resolves through `bunx varlock`
# before node_modules exists (cloud-agent and fresh-clone installs).
# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(id=development, token=$CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN, allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @initOp(id=production, token=$DEPLOY_AGENT_PRODUCTION_OP_TOKEN, allowAppAuth=false)
# @currentEnv=$VARLOCK_ENV
# Lifecycles: production and development resolve through 1Password; test
# resolves to fake-but-shaped literals only, so schema validation and the Bun
# test suites run fully offline with no 1Password access. Every lifecycle
# resolves deliberately — add a test arm whenever you add a variable.
# Sensitivity fails safe: an item without an explicit marker resolves as
# sensitive, so a forgotten decorator becomes a container secret rather than a
# plaintext value baked into a website bundle. Public values must opt out
# explicitly.
# @defaultSensitive=true @defaultRequired=infer
# ---

# Varlock's selector. The enum is the fail-loud guard: any other value —
# including lifecycles varlock can infer in CI, like preview — is rejected at
# load instead of silently riding each value's development arm.
# @public @auditIgnore @type=enum(development, production, test)
VARLOCK_ENV=development


# --- Bootstrap identities ------------------------------------------------
# One per unattended consumer; the name encodes the consumer and lifecycle it
# serves. Supervised local work uses 1Password desktop-app authorization
# instead. Both are @internal, so `varlock run` never exports them into the
# server container or a website build.

# Production deploy-agent role slot: each deploy venue supplies its own
# identity under this one name — the self-hosted GitHub Actions runner injects
# the GitHub deploy agent's token (GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN secret),
# and an operator run resolves the Mac Mini identity through `op run` in the
# deploy script.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @required=forEnv(production)
DEPLOY_AGENT_PRODUCTION_OP_TOKEN=

# Shared Cursor cloud-agent development identity, read-only on the Development
# vault, injected by Cursor as an account-scoped Runtime Secret. Supervised
# local development leaves this empty and uses desktop-app authorization.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN=


# --- Context switches ----------------------------------------------------
# Machinery credentials resolve ONLY behind these switches. Build, dev-server,
# test, and ordinary production resolution therefore never contact 1Password —
# which matters because Vite and the Docker build re-resolve the whole schema
# in contexts that cannot authenticate.

# Set to true by the install script when fetching install tokens with
# `varlock printenv`.
# @public @internal @auditIgnore @type=boolean
ETSYSENTRY_RESOLVE_INSTALL_TOKENS=false

# Set to true by the deploy script when fetching deploy-time credentials.
# @public @internal @auditIgnore @type=boolean
ETSYSENTRY_RESOLVE_DEPLOY_TOKENS=false

# Set to true by the npm release flow when fetching the publish token. Release
# is a third context, distinct from install and deploy: it targets the Tooling
# lifecycle vault and runs only from an operator release session.
# @public @internal @auditIgnore @type=boolean
ETSYSENTRY_RESOLVE_RELEASE_TOKENS=false


# --- Machinery credentials -----------------------------------------------

# Installing the private @merchbaseco/* packages. Shared suite credential: the
# name identifies the issuing owner, not this repo, and it resolves from the
# existing shared item rather than a per-repo copy. Referenced literally by
# .npmrc. CI and the deploy runner inject their own platform copy (the
# workflow's repository-scoped github.token), which wins as process env.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_GITHUB_NPM_TOKEN=if(eq($ETSYSENTRY_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/GitHub Packages Read - Merchbase/credential"), "")

# Publishing @etsysentry/cli and @etsysentry/http-client to the public npm
# registry. Shared suite credential: one Merchbase publish token serves every
# package, so the name identifies the issuing owner rather than this repo.
# Referenced literally by .npmrc, and gated by this repo's own release switch
# because only an EtsySentry release run needs it.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_NPM_PUBLISH_TOKEN=if(eq($ETSYSENTRY_RESOLVE_RELEASE_TOKENS, true), op(development, "op://Tooling/NPM Publish - Merchbase/credential"), "")


# --- Shared Merchbase Clerk credentials -----------------------------------
# The suite Clerk instance. The env name identifies the shared owner, not this
# app, and every value resolves from the existing shared `Clerk - Merchbase`
# item — no per-repo copy is created.

# @type=url @public
MERCHBASE_CLERK_ISSUER=if(eq($VARLOCK_ENV, test), https://clerk.test, https://clerk.merchbase.co)

# Publishable by design, but kept in the contract so development and production
# cannot drift silently.
# @public
MERCHBASE_CLERK_PUBLISHABLE_KEY=if(eq($VARLOCK_ENV, test), pk_test_etsysentry, if(eq($VARLOCK_ENV, production), pk_live_Y2xlcmsubWVyY2hiYXNlLmNvJA, op(development, "op://Development/Clerk - Merchbase/publishable key")))

# @sensitive @required
MERCHBASE_CLERK_SECRET_KEY=if(eq($VARLOCK_ENV, test), sk_test_example, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Clerk - Merchbase/credential"), op(development, "op://Development/Clerk - Merchbase/credential")))

# @sensitive @required
MERCHBASE_CLERK_JWT_KEY=if(eq($VARLOCK_ENV, test), test-jwt-key, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Clerk - Merchbase/JWT public key"), op(development, "op://Development/Clerk - Merchbase/JWT public key")))


# --- EtsySentry-owned Clerk configuration ---------------------------------

# Comma-separated exact bearer-token parties. Production carries exactly the
# dashboard origin, matching the value the live stack runs today. Endpoint
# policy, so it is project-owned even though the Clerk instance is shared.
# @public
ETSYSENTRY_CLERK_AUTHORIZED_PARTIES=if(eq($VARLOCK_ENV, production), "https://etsysentry.merchbase.co", "http://localhost:3100")

# Signing secret for this repo's own Clerk webhook endpoint. Endpoint-specific,
# so it is project-owned even though the Clerk instance is shared.
# @sensitive @required=forEnv(production)
ETSYSENTRY_CLERK_WEBHOOK_SIGNING_SECRET=if(eq($VARLOCK_ENV, test), whsec_test, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Clerk Webhook - EtsySentry/credential"), undefined))

# Stable Merchbase user id for the retained admin operator. Unset disables the
# admin tRPC surface entirely.
# @sensitive @optional
ETSYSENTRY_ADMIN_MERCHBASE_USER_ID=if(eq($VARLOCK_ENV, test), mbu_test_admin, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Admin User - EtsySentry/username"), undefined))


# --- Server runtime configuration ----------------------------------------

# @public @type=port
ETSYSENTRY_PORT=8080

# Exact browser origin allowed to call the API and open the realtime socket.
# @public @type=url
ETSYSENTRY_APP_ORIGIN=if(eq($VARLOCK_ENV, production), https://etsysentry.merchbase.co, http://localhost:3100)

# Compose resolves the database over the container network. Local development
# deliberately targets the SAME database over Tailscale — EtsySentry has no
# separate development dataset, so `Postgres - EtsySentry` is one credential
# stored in both lifecycle vaults. A venue without Tailscale (the Cursor cloud
# agent) provisions its own local cluster and overrides this public value in
# its own process environment for that session.
# @public
ETSYSENTRY_DATABASE_HOST=ifs(eq($VARLOCK_ENV, production), postgres, eq($VARLOCK_ENV, test), 127.0.0.1, zachs-mac-mini.taila0b849.ts.net)

# @public @type=port
ETSYSENTRY_DATABASE_PORT=if(eq($VARLOCK_ENV, production), 5432, 5435)

# @public
ETSYSENTRY_DATABASE_NAME=etsysentry

# @public
ETSYSENTRY_DATABASE_USER=etsysentry

# @sensitive @required
ETSYSENTRY_DATABASE_PASSWORD=if(eq($VARLOCK_ENV, test), etsysentry-test-password, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - EtsySentry/password"), op(development, "op://Development/Postgres - EtsySentry/password")))

# Local server scripts disable the pg-boss job runner by default; production
# runs it.
# @public @type=boolean
ETSYSENTRY_DISABLE_SERVER_JOB_RUNNER=if(eq($VARLOCK_ENV, production), false, true)


# --- Etsy API credentials and tuning (EtsySentry-owned) -------------------

# Etsy Developer App keystring and shared secret for OAuth 2.0 + PKCE.
# Test literals are deliberately distinctive: varlock masks every occurrence of
# a sensitive value in child output, so a literal like "test" would redact
# ordinary words out of test logs.
# @sensitive @required
ETSYSENTRY_ETSY_API_KEY=if(eq($VARLOCK_ENV, test), etsysentry-test-keystring, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Etsy API - EtsySentry/username"), op(development, "op://Development/Etsy API - EtsySentry/username")))

# @sensitive @required
ETSYSENTRY_ETSY_API_SHARED_SECRET=if(eq($VARLOCK_ENV, test), etsysentry-test-shared-secret, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Etsy API - EtsySentry/credential"), op(development, "op://Development/Etsy API - EtsySentry/credential")))

# Must match the callback registered in the Etsy app settings, and the server
# rejects any path other than /auth/etsy/callback.
# @public @type=url
ETSYSENTRY_ETSY_OAUTH_REDIRECT_URI=if(eq($VARLOCK_ENV, production), https://etsysentry.merchbase.co/auth/etsy/callback, http://localhost:8080/auth/etsy/callback)

# Space-delimited; listings_r is always added by the server.
# @public
ETSYSENTRY_ETSY_OAUTH_SCOPES=listings_r listings_w shops_r transactions_r

# @public @type=number
ETSYSENTRY_ETSY_OAUTH_STATE_TTL_MS=600000

# @public @type=number
ETSYSENTRY_ETSY_OAUTH_REFRESH_SKEW_MS=120000

# Rate-limit and retry defaults match Etsy's documented header examples and
# auto-adjust from live response headers.
# @public @type=number
ETSYSENTRY_ETSY_RATE_LIMIT_DEFAULT_PER_SECOND=150

# @public @type=number
ETSYSENTRY_ETSY_RATE_LIMIT_DEFAULT_PER_DAY=100000

# @public @type=number
ETSYSENTRY_ETSY_RATE_LIMIT_MAX_RETRIES=5

# @public @type=number
ETSYSENTRY_ETSY_RATE_LIMIT_BACKOFF_INITIAL_MS=1000

# @public @type=number
ETSYSENTRY_ETSY_RATE_LIMIT_BACKOFF_MAX_MS=60000

# @public @type=number
ETSYSENTRY_ETSY_API_REQUEST_TIMEOUT_MS=30000


# --- Website build inputs -------------------------------------------------
# External literal-prefix exemption: Vite only exposes variables whose name
# begins with VITE_, so the prefix is a platform requirement. The owner prefix
# follows it, keeping one canonical owner per value. Everything here is inlined
# into a public browser bundle at build time and must therefore be @public —
# never place a secret behind a VITE_ name.

# @public
VITE_MERCHBASE_CLERK_PUBLISHABLE_KEY=$MERCHBASE_CLERK_PUBLISHABLE_KEY

# Same-origin /api when empty; set only for a split-origin preview.
# @public @optional
VITE_ETSYSENTRY_SERVER_ORIGIN=
