{
  "name": "@etsysentry/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --target bun --outdir ./dist",
    "start": "bun run ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./src/db/migrate-runner.ts",
    "db:seed:dev": "bun run ./src/dev-seed/seed-dev-data.ts",
    "db:migrate:phase1": "bun run ./src/db/migrate-runner.ts --through 0020_early_agent_zero",
    "db:migrate:phase2": "bun run ./src/db/migrate-runner.ts --through 0021_known_sandman",
    "access:audit": "bun run ./src/scripts/central-auth-cutover.ts audit",
    "access:plan": "bun run ./src/scripts/central-auth-cutover.ts plan",
    "access:backfill": "bun run ./src/scripts/central-auth-cutover.ts backfill"
  },
  "dependencies": {
    "@merchbaseco/access": "0.3.0",
    "@fastify/cors": "11.2.0",
    "@trpc/server": "11.10.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "pg-boss": "12.13.0",
    "postgres": "3.4.8",
    "ws": "8.20.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/ws": "8.18.1",
    "bun-types": "1.3.9",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3"
  }
}
