node_modules/
**/node_modules/
**/dist/
.context/
.DS_Store

.env
.env.*

# Varlock schema is the committed contract
!.env.schema

# Cursor links fleet skills into .agents/skills; the cloud agent scripts stay tracked.
.agents/*
!.agents/cloud/

# Claude-managed worktrees carry nested biome configs that break lint at config load;
# the cloud agent adapter stays tracked.
.claude/*
!.claude/settings.json
